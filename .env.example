# ================================================
# MOMENTUM - ENVIRONMENT VARIABLES TEMPLATE
# ================================================
# Copy this file to .env.local for development
# or .env.production for production deployment

# ===========================================
# NETWORK CONFIGURATION
# ===========================================
# For local development: local
# For production: ic
VITE_DFX_NETWORK=local

# For local development: http://localhost:4943
# For production: https://icp-api.io
VITE_IC_HOST=http://localhost:4943

# ===========================================
# CANISTER IDs
# ===========================================
# Your User Management Canister ID
# Get this after deploying: dfx canister id user_management
VITE_USER_MANAGEMENT_CANISTER_ID=your-user-management-canister-id

# Internet Identity Canister ID
# Local: varies by deployment
# Production: rdmx6-jaaaa-aaaaa-aaadq-cai
VITE_INTERNET_IDENTITY_CANISTER_ID=rdmx6-jaaaa-aaaaa-aaadq-cai

# ===========================================
# AUTHENTICATION URLS
# ===========================================
# Internet Identity URL
# Local: http://localhost:4943/?canisterId=YOUR_LOCAL_II_CANISTER_ID
# Production: https://identity.ic0.app
VITE_INTERNET_IDENTITY_URL=http://localhost:4943/?canisterId=rdmx6-jaaaa-aaaaa-aaadq-cai

# NFID URL (same for local and production)
VITE_NFID_URL=https://nfid.one/authenticate

# ===========================================
# NODE ENVIRONMENT
# ===========================================
NODE_ENV=development
